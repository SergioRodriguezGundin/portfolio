---
import Contact from '@components/profile/Contact.astro';
import Curriculum from '@components/profile/Curriculum.astro';
import Experience from '@components/profile/Experience.astro';
import Journey from '@components/profile/Journey.astro';
import Location from '@components/profile/Location.astro';
import PersonalInformation from '@components/profile/PersonalInformation.astro';
import Techs from '@components/profile/Techs.astro';
import ProjectSliders from '@components/projects/ProjectSliders.astro';
import Layout from '@layouts/Layout.astro';
---

<Layout
  title="Hi! I'm Sergio. I'm a software developer from Spain."
  description='This is the mockup of the home page of my portfolio.'
>
  <div class='h-full'>
    <div class='layout mx-auto my-auto p-4 pt-16 md:pt-8 xl:p-6'>
      <div class='say-hello sp-wipe-in' style='--i: 0'>
        <PersonalInformation />
      </div>
      <div class='about-me sp-wipe-in flex flex-col gap-6 mt-6' style='--i: 1'>
        <Experience />
        <div class='flex flex-row justify-between gap-3 w-full'>
          <div class='w-full md:w-auto'>
            <Contact />
          </div>
          <div class='hidden md:flex w-full'>
            <Curriculum />
          </div>
        </div>
        <Location />
      </div>
      <div class='tech-love sp-wipe-in my-14 md:my-0' style='--i: 2'>
        <Techs />
      </div>
      <div class='my-journey sp-wipe-in mb-14 md:mb-0' style='--i: 3'>
        <Journey />
      </div>
      <div class='my-proyects sp-wipe-in flex flex-center' style='--i: 4'>
        <ProjectSliders />
      </div>
    </div>
  </div>
</Layout>

<style is:global>
  .layout {
    --grid-row-gap: 16px;
    --grid-column-width: 390px;

    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: 1fr 2.4fr;
    grid-column-gap: calc(var(--grid-row-gap) * 2);
    height: 100%;
    max-width: 1200px;
    width: 100%;
  }
  .say-hello {
    grid-area: 1 / 1 / 2 / 2;
  }
  .about-me {
    grid-area: 2 / 1 / 3 / 2;
  }
  .tech-love {
    grid-area: 1 / 2 / 2 / 3;
    width: var(--grid-column-width);
  }
  .my-journey {
    grid-area: 1 / 3 / 2 / 4;
  }
  .my-proyects {
    position: relative;
    grid-area: 2 / 2 / 3 / 4;
    width: 100%;
  }

  @media (max-width: 768px) {
    .layout {
      --grid-column-width: 350px;
      grid-template-columns: 1fr;
      grid-template-rows: repeat(5, 1fr);
      grid-column-gap: 0px;
      max-width: 100%;
      width: 100%;
    }
    .say-hello {
      grid-area: 1 / 1 / 2 / 2;
      height: 290px;
    }
    .about-me {
      grid-area: 2 / 1 / 3 / 2;
    }
    .tech-love {
      grid-area: 3 / 1 / 4 / 2;
    }
    .my-journey {
      grid-area: 4 / 1 / 5 / 2;
    }
    .my-proyects {
      grid-area: 5 / 1 / 6 / 2;
      height: 100%;
    }
  }

  @media (min-width: 1800px) {
    .layout {
      grid-row-gap: var(--grid-row-gap);
    }
  }
</style>
