---
import audience from '@assets/images/audience.webp';
import flame from '@assets/images/flame.webp';
import hand from '@assets/images/hand.webp';
import pinned from '@assets/images/pinned.webp';
import rocket from '@assets/images/rocket.webp';
import trophy from '@assets/images/trophy.webp';
import flag from '@assets/images/flag.webp';
import thunder from '@assets/images/thunder.webp';
import ProjectHighlights from '@components/profile/ProjectHighlights.astro';
import { CollectionEntry } from 'astro:content';

export interface MilestoneProps {
  milestone: CollectionEntry<'projects'>['data']['milestones'][number];
  index: number;
}

const { milestone, index } = Astro.props as MilestoneProps;

const milestoneIconMap = {
  rocket: rocket,
  pinned: pinned,
  flame: flame,
  hand: hand,
  audience: audience,
  flag: flag,
  thunder: thunder,
};

const icon = milestoneIconMap[milestone.icon as keyof typeof milestoneIconMap];
---

{
  index === 0 && (
    <div class='sp-card sp-card--primary relative overflow-hidden w-full md:w-[375px] h-[230px] md:h-[285px]'>
      <h3 class='relative z-10 font-display text-h2'>{milestone.title}</h3>
      <div class='relative z-10'>
        <ProjectHighlights highlights={milestone.strongPoints ?? []} />
      </div>
      <img
        src={trophy.src}
        width={250}
        height={250}
        alt=''
        class='absolute -bottom-10 -right-20 z-0 opacity-10'
      />
    </div>
  )
}

{
  index !== 0 && (
    <div class='sp-card relative overflow-hidden p-4 w-[150px] h-[75px] md:h-[125px]'>
      <span class='relative z-10 font-bold text-body'>{milestone.title}</span>
      {icon && (
        <img
          src={icon.src}
          width={55}
          height={55}
          alt=''
          class='absolute -bottom-2 right-0 z-0 opacity-10'
        />
      )}
    </div>
  )
}
