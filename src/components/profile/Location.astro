---
import locationPicture from '@assets/images/location.webp';
---

<div class='sp-card flex-row items-stretch p-0 gap-0 h-20 w-full'>
  <div class='flex-1 flex flex-col justify-center items-start gap-1 px-4'>
    <span class='sp-label'>Based on</span>
    <p class='font-display text-h3'>Madrid, Spain</p>
  </div>
  <div class='relative w-1/2 overflow-hidden'>
    <img
      src={locationPicture.src}
      alt='Sergio Rodriguez Gundin based on Spain'
      class='w-full h-full object-cover dark:invert'
    />
    <span class='location-dot sp-breathe bg-link rounded-round'></span>
  </div>
</div>

<style>
  .location-dot {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 14px;
    height: 14px;
    margin: -7px 0 0 -7px;
  }
</style>
