---
import LinkedinContact from '@components/icons/LinkedinContact.astro';
import Discord from '@components/icons/Discord.astro';
import Github from '@components/icons/GitHub.astro';

const contactLinks = [
  {
    href: 'https://www.linkedin.com/in/sergio-rodríguez-gundin-435a6713b',
    label: 'sergio rodriguez gundin linkedin profile',
    icon: LinkedinContact,
  },
  {
    href: 'https://github.com/SergioRodriguezGundin',
    label: 'sergio rodriguez gundin github profile',
    icon: Github,
  },
  {
    href: 'https://discord.com/users/321234123412341234',
    label: 'sergio rodriguez gundin discord profile',
    icon: Discord,
  },
];
---

<div class='contact flex flex-row md:flex-col justify-between gap-3 h-full w-full'>
  {
    contactLinks.map(({ href, label, icon: Icon }) => (
      <a
        href={href}
        target='_blank'
        aria-label={label}
        class='contact-link sp-card sp-card--blue flex-1 md:flex-none items-center justify-center p-0 h-24 w-full md:w-24'
      >
        <Icon size={{ width: 36, height: 36 }} />
      </a>
    ))
  }
</div>

<style>
  .contact-link:focus-visible {
    outline: 2px solid var(--link);
    outline-offset: 4px;
  }
</style>
