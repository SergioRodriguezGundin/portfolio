---
const cvUrl =
  'https://cdn.jsdelivr.net/gh/sergiorodriguezgundin/portfolio@main/public/cv/SergioRodriguez.pdf';
---

<button
  class='download-button sp-card items-start text-left cursor-pointer h-full w-full'
  aria-label='download 2026 resume'
>
  <span class='flex flex-col items-start gap-1'>
    <span class='sp-label'>2026 CV</span>
    <span class='font-display text-h3'>Resume</span>
  </span>
  <!-- The code always sits on paper so it stays scannable in both themes. -->
  <span class='flex justify-center items-center bg-paper p-2 w-full'>
    <qr-code
      id='qrCV'
      contents={cvUrl}
      module-color='#010300'
      position-ring-color='#010300'
      position-center-color='#0910ec'
    >
    </qr-code>
  </span>
</button>

<script>
  import * as qr from '@bitjson/qr-code';

  qr.defineCustomElements(window);
  document.getElementById('qrCV')?.addEventListener('codeRendered', () => {
    (document.getElementById('qrCV') as any).animateQRCode('FadeInCenterOut');
  });

  const downloadButton = document.querySelector('.download-button');
  downloadButton?.addEventListener('click', () => {
    const link = document.createElement('a');
    link.href =
      'https://cdn.jsdelivr.net/gh/sergiorodriguezgundin/portfolio@main/public/cv/SergioRodriguez.pdf';
    link.download = 'sergio-rodriguez-cv.pdf';
    link.click();
  });
</script>

<style>
  #qrCV {
    width: 185px;
    height: 185px;
  }
  .download-button:focus-visible {
    outline: 2px solid var(--link);
    outline-offset: 4px;
  }
</style>
