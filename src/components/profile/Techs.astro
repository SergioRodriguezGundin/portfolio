---
import ProjectTechCard from '@components/projects/ProjectTechCard.astro';
import {
  ANGULAR,
  ASTRO,
  JS,
  NEXTJS,
  NGRX,
  REACT,
  THREEJS,
  TYPESCRIPT,
} from '@components/projects/ProjectTechIcon.astro';

const techIcons = [JS, TYPESCRIPT, ANGULAR, NGRX, REACT, NEXTJS, ASTRO, THREEJS];
---

<div class='sp-card sp-card--blue items-center justify-center w-full h-full'>
  <ul class='grid grid-cols-4 gap-4' aria-label='technologies'>
    {
      techIcons.map((icon) => (
        <li>
          <ProjectTechCard icon={icon} />
        </li>
      ))
    }
  </ul>
</div>
