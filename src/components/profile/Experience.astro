---
const stats = [
  { value: '+08', label: 'Years of experience' },
  { value: '+09', label: 'Projects worked' },
];
---

<div class='sp-card sp-card--primary flex-row justify-around p-4 w-full'>
  {
    stats.map((stat) => (
      <div class='flex flex-col items-center gap-1'>
        <span class='font-display text-h1'>{stat.value}</span>
        <span class='sp-label'>{stat.label}</span>
      </div>
    ))
  }
</div>
