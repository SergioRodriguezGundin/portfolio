---
import { getCollection, type CollectionEntry } from 'astro:content';

const journey: CollectionEntry<'journey'>[] = await getCollection('journey');
const sortedJourney = journey.sort(
  (a, b) => b.data.sortOrder - a.data.sortOrder
);
---

<ol class='sp-card justify-center gap-1 p-4 h-full'>
  {
    sortedJourney.map((item, index) => {
      const isCurrent = index === 0;
      return (
        <li class='flex flex-row justify-between items-start gap-2 w-full'>
          <p
            class:list={[
              'flex-1',
              isCurrent ? 'font-display text-h3' : 'text-body line-through',
            ]}
          >
            {item.data.jobPosition}
          </p>
          <div class='flex flex-col items-end text-right'>
            <a
              href={item.data.url}
              target='_blank'
              class:list={[
                'hover:text-link focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-link',
                isCurrent ? 'font-bold text-body' : 'text-body',
              ]}
            >
              {item.data.company}
            </a>
            <span class='sp-label'>{item.data.period}</span>
          </div>
        </li>
      );
    })
  }
</ol>
