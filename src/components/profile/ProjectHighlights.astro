---
interface Props {
  highlights: string[];
}

const { highlights } = Astro.props;
---

<ul class='flex flex-col gap-2'>
  {
    highlights.map((highlight) => (
      <li class='flex flex-row items-center gap-2 text-body'>
        <span class='inline-block w-2 h-2 bg-ultramarine shrink-0' aria-hidden='true' />
        {highlight}
      </li>
    ))
  }
</ul>
