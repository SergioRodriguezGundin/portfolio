---
import ProfileImage from '@components/profile/ProfileImage.astro';
import ThemeButton from '@components/ThemeButton.astro';

const sayHiHref =
  'mailto:sergio.gundin.rodriguez@gmail.com?subject=Hello&body=I wanted to contact you!';
---

<div class='sp-card relative justify-end w-full h-full'>
  <div class='absolute top-4 right-4 z-10 flex flex-row items-start gap-4'>
    <ProfileImage />
    <ThemeButton />
  </div>
  <a class='sp-btn sp-btn--primary self-start' href={sayHiHref}>Say Hi!</a>
  <section class='flex flex-col items-start gap-2'>
    <h2 class='font-display text-h2'>Hello!<br />I'm Sergio</h2>
    <h1 class='sp-label text-link'>Software engineer</h1>
    <p class='text-body'>
      Welcome to my humble home on the web. I want to share with you my journey
      recap throw all the projects I've been working on.
    </p>
  </section>
</div>
